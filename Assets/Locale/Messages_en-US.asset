MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Messages_en-US
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en-US
  m_SharedData: {fileID: 11400000, guid: b3c261fdad144b5429725ee1fd46cb85, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 25312727040
    m_Localized: Press {DismissPopup} to dismiss.
    m_Metadata:
      m_Items: []
  - m_Id: 121890770944
    m_Localized: hi! it's me, clippy. it looks like you're having trouble aiming.
      press {CameraLock} to lock on, you sick fuck. Also use {Move} to move around.
    m_Metadata:
      m_Items: []
  - m_Id: 41735929565184
    m_Localized: 'Now entering: Petrichor Landing.

      Your mission: Find and
      destroy the False Idol, and any errant Angels you come across.'
    m_Metadata:
      m_Items: []
  - m_Id: 43201415188480
    m_Localized: 'Use {Fire1} and {Fire2} to shoot.


      Lock on to targets with
      {CameraLock}. Looking with {Look} while the camera is locked will switch targets.'
    m_Metadata:
      m_Items: []
  - m_Id: 80781078794240
    m_Localized: "The beam emanating from an Angel's eye glows brightly as it is
      about to attack. \n\nQuickly tap and release {Dodge} to Dodge in the direction
      you're moving."
    m_Metadata:
      m_Items: []
  - m_Id: 88040836009984
    m_Localized: You can Jump {Jump} and Hover {Hover} midair at the cost of BOOST.
      BOOST recharges when your mech lands on the ground.
    m_Metadata:
      m_Items: []
  - m_Id: 88926194864128
    m_Localized: 'Jumping - but not hovering - consumes BOOST. '
    m_Metadata:
      m_Items: []
  - m_Id: 91091038736384
    m_Localized: Hold {Sprint} while on the ground to sprint. Sprinting allows for
      fast, grounded traversal at the cost of accuracy.
    m_Metadata:
      m_Items: []
  - m_Id: 3607375273627648
    m_Localized: Use {Move.Composite} to move. Look around with {Look}.
    m_Metadata:
      m_Items: []
  - m_Id: 3609412543549440
    m_Localized: Looking in any direction while your mech is locked-on to a target
      will attempt to find a new target in that direction.
    m_Metadata:
      m_Items: []
  - m_Id: 4324017980936192
    m_Localized: SAVED GAME
    m_Metadata:
      m_Items: []
  - m_Id: 4483664964587520
    m_Localized: ... Uplink complete. Welcome to your new body, child. Before you
      ascend to the surface world, take some time to become accustomed to the changes
      you've undergone.
    m_Metadata:
      m_Items: []
  - m_Id: 4484930050560000
    m_Localized: Some structures are destructible, but cannot be locked onto.
    m_Metadata:
      m_Items: []
  - m_Id: 4485893905813504
    m_Localized: Beyond this point is a simulacrum chamber containing a captured
      Angel. Proceed, and destroy it. Prove you are capable of survival on the surface.
    m_Metadata:
      m_Items: []
  - m_Id: 4486124378624000
    m_Localized: ' Move {Move} Look {Look} Lock Aim {CameraLock}  Jump {Jump}  Hover
      (hold) {Hover}  Sprint (hold) {Sprint}  Dash {Dodge}  Left Hand {Fire1}  Right
      Hand {Fire2}  Interact {DismissPopup}'
    m_Metadata:
      m_Items: []
  - m_Id: 6456474616303616
    m_Localized: '{DismissPopup} Interact'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
